<?php

/**
 * @file
 * PWC Visual Editor module.
 *
 * Provides front-end visual content editing capabilities.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Url;
use Drupal\node\NodeInterface;

/**
 * Implements hook_help().
 */
function pwc_visual_editor_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.pwc_visual_editor':
      $output = '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('The PWC Visual Editor provides a front-end content editing experience similar to Webflow or WordPress Gutenberg.') . '</p>';
      $output .= '<h4>' . t('Creating Visual Pages') . '</h4>';
      $output .= '<p>' . t('Go to <a href="@url">/visual-editor/add</a> to create a new Visual Page.', ['@url' => '/visual-editor/add']) . '</p>';
      return $output;
  }
}

/**
 * Implements hook_page_attachments().
 */
function pwc_visual_editor_page_attachments(array &$attachments) {
  // Only attach on node pages
  $route_match = \Drupal::routeMatch();
  $node = $route_match->getParameter('node');

  if (!$node instanceof NodeInterface) {
    return;
  }

  // Only enable for visual_page content type
  if ($node->bundle() !== 'visual_page') {
    return;
  }

  // Check if user can edit
  $canEdit = \Drupal::currentUser()->hasPermission('use pwc visual editor') && $node->access('update');

  // Appkit4 CSS
  $attachments['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'link',
      '#attributes' => [
        'rel' => 'stylesheet',
        'href' => 'https://appkitcdn.pwc.com/appkit4/cdn/styles/4.10.3/appkit.min.css',
      ],
    ],
    'appkit4_css',
  ];

  // Appkit4 Web Components (ESM)
  $attachments['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'script',
      '#attributes' => [
        'type' => 'module',
        'src' => 'https://appkitcdn.pwc.com/appkit4/cdn/web-components/1.15.0/dist/appkit4/appkit4.esm.js',
      ],
    ],
    'appkit4_js',
  ];

  // Only attach editor library and settings if user can edit
  if ($canEdit) {
    // Load saved content for JS
    $content = [];
    if ($node->hasField('field_page_content') && !$node->get('field_page_content')->isEmpty()) {
      $json = $node->get('field_page_content')->value;
      $content = json_decode($json, TRUE) ?: [];
    }

    // Attach the editor library
    $attachments['#attached']['library'][] = 'pwc_visual_editor/editor';

    // Pass settings to JavaScript
    $attachments['#attached']['drupalSettings']['pwcVisualEditor'] = [
      'nodeId' => $node->id(),
      'nodeType' => $node->bundle(),
      'canEdit' => $canEdit,
      'content' => $content,
      'csrfToken' => \Drupal::csrfToken()->get('rest'),
      'saveUrl' => Url::fromRoute('pwc_visual_editor.save', ['node' => $node->id()])->toString(),
      'editUrl' => Url::fromRoute('pwc_visual_editor.edit', ['node' => $node->id()])->toString(),
      'viewMode' => TRUE,
    ];
  }
}

/**
 * Implements hook_theme().
 */
function pwc_visual_editor_theme($existing, $type, $theme, $path) {
  return [
    'pwc_visual_editor_wrapper' => [
      'variables' => [
        'content' => NULL,
        'node_id' => NULL,
      ],
      'template' => 'editor-wrapper',
    ],
    'pwc_visual_editor_add' => [
      'variables' => [],
      'template' => 'visual-editor-add',
    ],
    'pwc_visual_editor_edit' => [
      'variables' => [
        'node' => NULL,
        'content' => [],
      ],
      'template' => 'visual-editor-edit',
    ],
    'node__visual_page' => [
      'template' => 'node--visual-page',
      'base hook' => 'node',
    ],
  ];
}

/**
 * Implements hook_preprocess_node().
 */
function pwc_visual_editor_preprocess_node(&$variables) {
  $node = $variables['node'];

  // Only process visual_page content type
  if ($node->bundle() !== 'visual_page') {
    return;
  }

  // Load content for rendering
  $content = [];
  if ($node->hasField('field_page_content') && !$node->get('field_page_content')->isEmpty()) {
    $json = $node->get('field_page_content')->value;
    $content = json_decode($json, TRUE) ?: [];
  }

  // Attach block view styles for all visitors
  $variables['#attached']['library'][] = 'pwc_visual_editor/blocks';

  // Check if user has permission to edit
  $canEdit = \Drupal::currentUser()->hasPermission('use pwc visual editor') && $node->access('update');
  $variables['can_edit'] = $canEdit;

  if ($canEdit) {
    // Admin mode: empty div for JavaScript to render into
    $variables['rendered_blocks'] = NULL;
    $variables['visual_editor_edit_url'] = Url::fromRoute('pwc_visual_editor.edit', ['node' => $node->id()])->toString();
  }
  else {
    // View mode: Server-side render the blocks as HTML
    $blocks = $content['blocks'] ?? [];
    $variables['rendered_blocks'] = pwc_visual_editor_render_blocks($blocks);
  }
}

/**
 * Sanitize inline HTML content, allowing only safe formatting tags.
 *
 * @param string $content
 *   Raw content that may contain HTML.
 *
 * @return string
 *   Sanitized HTML with only allowed tags.
 */
function pwc_visual_editor_sanitize_inline_html(string $content): string {
  // List of allowed inline formatting tags
  $allowed_tags = '<strong><em><b><i><a><span><br><sub><sup><mark><code>';

  // Strip all tags except allowed ones
  $content = strip_tags($content, $allowed_tags);

  // Sanitize attributes on allowed tags (especially important for <a> tags)
  // Use DOMDocument for more thorough sanitization
  if (strpos($content, '<') !== FALSE) {
    $content = pwc_visual_editor_sanitize_tag_attributes($content);
  }

  return $content;
}

/**
 * Sanitize attributes on HTML tags to prevent XSS.
 *
 * @param string $html
 *   HTML content with allowed tags.
 *
 * @return string
 *   HTML with sanitized attributes.
 */
function pwc_visual_editor_sanitize_tag_attributes(string $html): string {
  // Wrap in a root element to ensure valid parsing
  $wrapped = '<div>' . $html . '</div>';

  $dom = new \DOMDocument();
  // Suppress warnings for malformed HTML
  @$dom->loadHTML('<?xml encoding="UTF-8">' . $wrapped, LIBXML_HTML_NOIMPLIED | LIBXML_HTML_NODEFDTD);

  // Allowed attributes per tag
  $allowed_attributes = [
    'a' => ['href', 'title', 'target', 'rel'],
    'span' => ['class'],
    'strong' => [],
    'em' => [],
    'b' => [],
    'i' => [],
    'br' => [],
    'sub' => [],
    'sup' => [],
    'mark' => [],
    'code' => ['class'],
  ];

  // Dangerous attribute patterns (event handlers, javascript:, etc.)
  $dangerous_patterns = [
    '/^on/i',  // onclick, onerror, etc.
    '/^javascript:/i',
    '/^vbscript:/i',
    '/^data:/i',
  ];

  // Process all elements
  $xpath = new \DOMXPath($dom);
  $elements = $xpath->query('//*');

  foreach ($elements as $element) {
    if (!$element instanceof \DOMElement) {
      continue;
    }

    $tagName = strtolower($element->tagName);

    // Skip the wrapper div
    if ($tagName === 'div' || $tagName === 'body' || $tagName === 'html') {
      continue;
    }

    // Get allowed attributes for this tag
    $tagAllowed = $allowed_attributes[$tagName] ?? [];

    // Remove disallowed attributes
    $attributesToRemove = [];
    foreach ($element->attributes as $attr) {
      $attrName = strtolower($attr->name);
      $attrValue = $attr->value;

      // Check if attribute is allowed
      if (!in_array($attrName, $tagAllowed)) {
        $attributesToRemove[] = $attr->name;
        continue;
      }

      // Check for dangerous patterns in value
      foreach ($dangerous_patterns as $pattern) {
        if (preg_match($pattern, $attrValue)) {
          $attributesToRemove[] = $attr->name;
          break;
        }
      }

      // Special handling for href - only allow safe protocols
      if ($attrName === 'href') {
        $parsed = parse_url($attrValue);
        $scheme = strtolower($parsed['scheme'] ?? '');
        if ($scheme && !in_array($scheme, ['http', 'https', 'mailto', 'tel'])) {
          $attributesToRemove[] = $attr->name;
        }
      }
    }

    // Remove the disallowed attributes
    foreach ($attributesToRemove as $attrName) {
      $element->removeAttribute($attrName);
    }

    // Add rel="noopener noreferrer" to external links
    if ($tagName === 'a' && $element->hasAttribute('href')) {
      $href = $element->getAttribute('href');
      if (strpos($href, 'http') === 0) {
        $element->setAttribute('rel', 'noopener noreferrer');
      }
    }
  }

  // Extract the content without the wrapper
  $result = '';
  $wrapper = $dom->getElementsByTagName('div')->item(0);
  if ($wrapper) {
    foreach ($wrapper->childNodes as $child) {
      $result .= $dom->saveHTML($child);
    }
  }

  return $result ?: $html;
}

/**
 * Render blocks as HTML for server-side rendering.
 *
 * @param array $blocks
 *   Array of block data.
 *
 * @return string
 *   Rendered HTML string.
 */
function pwc_visual_editor_render_blocks(array $blocks): string {
  $html = '';

  foreach ($blocks as $block) {
    $html .= pwc_visual_editor_render_block($block);
  }

  return $html;
}

/**
 * Render a single block as HTML.
 *
 * @param array $block
 *   Block data with type, id, attributes, and optional innerBlocks.
 *
 * @return string
 *   Rendered HTML string.
 */
function pwc_visual_editor_render_block(array $block): string {
  $type = $block['type'] ?? '';
  $attributes = $block['attributes'] ?? [];
  $innerBlocks = $block['innerBlocks'] ?? [];

  switch ($type) {
    case 'heading':
      return pwc_visual_editor_render_heading($attributes);

    case 'paragraph':
      return pwc_visual_editor_render_paragraph($attributes);

    case 'list':
      return pwc_visual_editor_render_list($attributes);

    case 'layout':
      return pwc_visual_editor_render_layout($attributes, $innerBlocks);

    case 'button':
      return pwc_visual_editor_render_button($attributes);

    case 'tag':
      return pwc_visual_editor_render_tag($attributes);

    case 'accordion':
      return pwc_visual_editor_render_accordion($attributes, $innerBlocks);

    case 'tab':
      return pwc_visual_editor_render_tab($attributes, $innerBlocks);

    default:
      // Unknown block type - render as comment for debugging
      return '<!-- Unknown block type: ' . htmlspecialchars($type) . ' -->';
  }
}

/**
 * Render a heading block.
 *
 * @param array $attributes
 *   Block attributes.
 *
 * @return string
 *   Rendered HTML.
 */
function pwc_visual_editor_render_heading(array $attributes): string {
  // Allow safe inline formatting tags, sanitize the rest
  $content = pwc_visual_editor_sanitize_inline_html($attributes['content'] ?? 'Heading');
  $level = $attributes['level'] ?? 'h2';

  // Validate heading level
  if (!in_array($level, ['h1', 'h2', 'h3', 'h4', 'h5', 'h6'])) {
    $level = 'h2';
  }

  // Mirror editor defaults (HeadingBlock.levelDefaults) when explicit values are absent.
  $levelDefaults = [
    'h1' => ['fontSize' => 'ap-font-48', 'fontWeight' => 'ap-font-weight-2'],
    'h2' => ['fontSize' => 'ap-font-36', 'fontWeight' => 'ap-font-weight-2'],
    'h3' => ['fontSize' => 'ap-font-30', 'fontWeight' => 'ap-font-weight-2'],
    'h4' => ['fontSize' => 'ap-font-20', 'fontWeight' => 'ap-font-weight-2'],
    'h5' => ['fontSize' => 'ap-font-18', 'fontWeight' => 'ap-font-weight-2'],
    'h6' => ['fontSize' => 'ap-font-16', 'fontWeight' => 'ap-font-weight-2'],
  ];
  $defaults = $levelDefaults[$level];
  $fontSize = $attributes['fontSize'] ?? '';
  $fontWeight = $attributes['fontWeight'] ?? '';
  if (empty($fontSize)) {
    $fontSize = $defaults['fontSize'];
  }
  if (empty($fontWeight)) {
    $fontWeight = $defaults['fontWeight'];
  }

  // Build class list from Tailwind utilities
  $classes = ['pwc-heading'];

  if (!empty($fontSize)) {
    $classes[] = htmlspecialchars($fontSize);
  }
  if (!empty($fontWeight)) {
    $classes[] = htmlspecialchars($fontWeight);
  }
  if (!empty($attributes['lineHeight'])) {
    $classes[] = htmlspecialchars($attributes['lineHeight']);
  }
  if (!empty($attributes['textAlign'])) {
    $classes[] = htmlspecialchars($attributes['textAlign']);
  }
  if (!empty($attributes['textColor'])) {
    $classes[] = htmlspecialchars($attributes['textColor']);
  }
  if (!empty($attributes['margin'])) {
    $classes[] = htmlspecialchars($attributes['margin']);
  }
  if (!empty($attributes['padding'])) {
    $classes[] = htmlspecialchars($attributes['padding']);
  }
  if (!empty($attributes['customClasses'])) {
    $classes[] = htmlspecialchars($attributes['customClasses']);
  }

  $classString = implode(' ', array_filter($classes));

  return "<{$level} class=\"{$classString}\">{$content}</{$level}>\n";
}

/**
 * Render a paragraph block.
 *
 * @param array $attributes
 *   Block attributes.
 *
 * @return string
 *   Rendered HTML.
 */
function pwc_visual_editor_render_paragraph(array $attributes): string {
  $content = $attributes['content'] ?? '';

  // Build container classes (gap, margin, padding, custom)
  $containerClasses = ['pwc-paragraph'];

  // Paragraph gap (default to space-y-4)
  $paragraphGap = $attributes['paragraphGap'] ?? 'space-y-4';
  if (!empty($paragraphGap)) {
    $containerClasses[] = htmlspecialchars($paragraphGap);
  }
  if (!empty($attributes['margin'])) {
    $containerClasses[] = htmlspecialchars($attributes['margin']);
  }
  if (!empty($attributes['padding'])) {
    $containerClasses[] = htmlspecialchars($attributes['padding']);
  }
  if (!empty($attributes['customClasses'])) {
    $containerClasses[] = htmlspecialchars($attributes['customClasses']);
  }

  // Build paragraph text classes
  $textClasses = ['pwc-paragraph__text'];

  if (!empty($attributes['fontSize'])) {
    $textClasses[] = htmlspecialchars($attributes['fontSize']);
  }
  if (!empty($attributes['fontWeight'])) {
    $textClasses[] = htmlspecialchars($attributes['fontWeight']);
  }
  if (!empty($attributes['lineHeight'])) {
    $textClasses[] = htmlspecialchars($attributes['lineHeight']);
  }
  if (!empty($attributes['textAlign'])) {
    $textClasses[] = htmlspecialchars($attributes['textAlign']);
  }
  if (!empty($attributes['textColor'])) {
    $textClasses[] = htmlspecialchars($attributes['textColor']);
  }

  $containerClassString = implode(' ', array_filter($containerClasses));
  $textClassString = implode(' ', array_filter($textClasses));

  // Convert <br><br> patterns to separate paragraphs
  $content = pwc_visual_editor_convert_double_br_to_paragraphs($content);

  // Check if content already has <p> tags
  if (strpos($content, '<p') !== FALSE) {
    // Content has paragraph tags - add classes to each <p>
    $content = preg_replace('/<p(\s|>)/', '<p class="' . $textClassString . '"$1', $content);
    // Sanitize the content (allow <p>, <br>, and inline formatting)
    $content = pwc_visual_editor_sanitize_paragraph_html($content);
    // Remove empty <p> tags
    $content = pwc_visual_editor_remove_empty_paragraphs($content);
  } else {
    // No paragraph tags - wrap in <p> and sanitize
    $content = pwc_visual_editor_sanitize_inline_html($content);
    if (trim($content)) {
      $content = "<p class=\"{$textClassString}\">{$content}</p>";
    } else {
      $content = '';
    }
  }

  // Don't render empty paragraph blocks
  if (!trim(strip_tags($content))) {
    return '';
  }

  return "<div class=\"{$containerClassString}\">{$content}</div>\n";
}

/**
 * Render a list block.
 *
 * @param array $attributes
 *   Block attributes.
 *
 * @return string
 *   Rendered HTML.
 */
function pwc_visual_editor_render_list(array $attributes): string {
  $content = $attributes['content'] ?? '<li>List item</li>';
  $listType = $attributes['listType'] ?? 'ul';

  // Validate list type
  if (!in_array($listType, ['ul', 'ol'])) {
    $listType = 'ul';
  }

  // Build list classes
  $listClasses = ['pwc-list__items'];

  // List style
  $listStyle = $attributes['listStyle'] ?? '';
  if (!empty($listStyle)) {
    $listClasses[] = htmlspecialchars($listStyle);
  }

  // List position
  $listPosition = $attributes['listPosition'] ?? 'list-outside';
  if (!empty($listPosition)) {
    $listClasses[] = htmlspecialchars($listPosition);
  }

  if (!empty($attributes['fontSize'])) {
    $listClasses[] = htmlspecialchars($attributes['fontSize']);
  }
  if (!empty($attributes['fontWeight'])) {
    $listClasses[] = htmlspecialchars($attributes['fontWeight']);
  }
  if (!empty($attributes['lineHeight'])) {
    $listClasses[] = htmlspecialchars($attributes['lineHeight']);
  }
  if (!empty($attributes['textAlign'])) {
    $listClasses[] = htmlspecialchars($attributes['textAlign']);
  }
  if (!empty($attributes['textColor'])) {
    $listClasses[] = htmlspecialchars($attributes['textColor']);
  }

  // Item gap
  $itemGap = $attributes['itemGap'] ?? 'space-y-2';
  if (!empty($itemGap)) {
    $listClasses[] = htmlspecialchars($itemGap);
  }

  if (!empty($attributes['margin'])) {
    $listClasses[] = htmlspecialchars($attributes['margin']);
  }
  if (!empty($attributes['padding'])) {
    $listClasses[] = htmlspecialchars($attributes['padding']);
  }
  if (!empty($attributes['customClasses'])) {
    $listClasses[] = htmlspecialchars($attributes['customClasses']);
  }

  $listClassString = implode(' ', array_filter($listClasses));

  // Sanitize list content - only allow <li> and inline formatting
  $content = pwc_visual_editor_sanitize_list_html($content);

  // Add classes to list items
  $content = preg_replace('/<li(\s|>)/', '<li class="pwc-list__item"$1', $content);

  // Don't render empty lists
  if (!trim(strip_tags($content))) {
    return '';
  }

  return "<{$listType} class=\"{$listClassString}\">{$content}</{$listType}>\n";
}

/**
 * Sanitize list HTML content, allowing only <li> and safe inline tags.
 *
 * @param string $content
 *   Raw content that may contain HTML.
 *
 * @return string
 *   Sanitized HTML with only allowed tags.
 */
function pwc_visual_editor_sanitize_list_html(string $content): string {
  // List of allowed tags for lists
  $allowed_tags = '<li><br><strong><em><b><i><a><span><sub><sup><mark><code>';

  // Strip all tags except allowed ones
  $content = strip_tags($content, $allowed_tags);

  // Sanitize attributes on allowed tags
  if (strpos($content, '<') !== FALSE) {
    $content = pwc_visual_editor_sanitize_list_attributes($content);
  }

  return $content;
}

/**
 * Sanitize attributes on list HTML tags.
 *
 * @param string $html
 *   HTML content with allowed tags.
 *
 * @return string
 *   HTML with sanitized attributes.
 */
function pwc_visual_editor_sanitize_list_attributes(string $html): string {
  // Wrap in a root element to ensure valid parsing
  $wrapped = '<div>' . $html . '</div>';

  $dom = new \DOMDocument();
  @$dom->loadHTML('<?xml encoding="UTF-8">' . $wrapped, LIBXML_HTML_NOIMPLIED | LIBXML_HTML_NODEFDTD);

  // Allowed attributes per tag
  $allowed_attributes = [
    'li' => ['class'],
    'a' => ['href', 'title', 'target', 'rel'],
    'span' => ['class'],
    'strong' => [],
    'em' => [],
    'b' => [],
    'i' => [],
    'br' => [],
    'sub' => [],
    'sup' => [],
    'mark' => [],
    'code' => ['class'],
  ];

  // Dangerous attribute patterns
  $dangerous_patterns = [
    '/^on/i',
    '/^javascript:/i',
    '/^vbscript:/i',
    '/^data:/i',
  ];

  $xpath = new \DOMXPath($dom);
  $elements = $xpath->query('//*');

  foreach ($elements as $element) {
    if (!$element instanceof \DOMElement) {
      continue;
    }

    $tagName = strtolower($element->tagName);

    if ($tagName === 'div' || $tagName === 'body' || $tagName === 'html') {
      continue;
    }

    $tagAllowed = $allowed_attributes[$tagName] ?? [];
    $attributesToRemove = [];

    foreach ($element->attributes as $attr) {
      $attrName = strtolower($attr->name);
      $attrValue = $attr->value;

      if (!in_array($attrName, $tagAllowed)) {
        $attributesToRemove[] = $attr->name;
        continue;
      }

      foreach ($dangerous_patterns as $pattern) {
        if (preg_match($pattern, $attrValue)) {
          $attributesToRemove[] = $attr->name;
          break;
        }
      }

      if ($attrName === 'href') {
        $parsed = parse_url($attrValue);
        $scheme = strtolower($parsed['scheme'] ?? '');
        if ($scheme && !in_array($scheme, ['http', 'https', 'mailto', 'tel'])) {
          $attributesToRemove[] = $attr->name;
        }
      }
    }

    foreach ($attributesToRemove as $attrName) {
      $element->removeAttribute($attrName);
    }

    if ($tagName === 'a' && $element->hasAttribute('href')) {
      $href = $element->getAttribute('href');
      if (strpos($href, 'http') === 0) {
        $element->setAttribute('rel', 'noopener noreferrer');
      }
    }
  }

  $result = '';
  $wrapper = $dom->getElementsByTagName('div')->item(0);
  if ($wrapper) {
    foreach ($wrapper->childNodes as $child) {
      $result .= $dom->saveHTML($child);
    }
  }

  return $result ?: $html;
}

/**
 * Remove empty <p> tags from content.
 *
 * @param string $content
 *   HTML content that may contain empty <p> tags.
 *
 * @return string
 *   Content with empty <p> tags removed.
 */
function pwc_visual_editor_remove_empty_paragraphs(string $content): string {
  // Remove <p> tags that are empty or only contain whitespace/br tags
  // Pattern matches <p ...></p> or <p ...><br></p> or <p ...>   </p>
  $content = preg_replace('/<p[^>]*>\s*(<br\s*\/?>)?\s*<\/p>/i', '', $content);

  return trim($content);
}

/**
 * Convert <br><br> patterns inside <p> tags to separate paragraphs.
 *
 * @param string $content
 *   HTML content that may contain <br><br> patterns.
 *
 * @return string
 *   Content with <br><br> converted to separate <p> tags.
 */
function pwc_visual_editor_convert_double_br_to_paragraphs(string $content): string {
  // Match <p> tags containing <br><br> (with optional whitespace)
  $pattern = '/<p([^>]*)>([\s\S]*?)<\/p>/i';

  return preg_replace_callback($pattern, function($matches) {
    $attrs = $matches[1];
    $innerContent = $matches[2];

    // Check if there are double <br> tags
    if (preg_match('/<br\s*\/?>\s*<br\s*\/?>/i', $innerContent)) {
      // Split by double <br> and create separate paragraphs
      $parts = preg_split('/<br\s*\/?>\s*<br\s*\/?>/i', $innerContent);
      $paragraphs = [];
      foreach ($parts as $part) {
        $part = trim($part);
        if ($part) {
          $paragraphs[] = "<p{$attrs}>{$part}</p>";
        }
      }
      return implode('', $paragraphs);
    }

    return $matches[0];
  }, $content);
}

/**
 * Sanitize paragraph HTML content, allowing <p>, <br>, and safe inline tags.
 *
 * @param string $content
 *   Raw content that may contain HTML.
 *
 * @return string
 *   Sanitized HTML with only allowed tags.
 */
function pwc_visual_editor_sanitize_paragraph_html(string $content): string {
  // List of allowed tags for paragraphs
  $allowed_tags = '<p><br><strong><em><b><i><a><span><sub><sup><mark><code>';

  // Strip all tags except allowed ones
  $content = strip_tags($content, $allowed_tags);

  // Sanitize attributes on allowed tags
  if (strpos($content, '<') !== FALSE) {
    $content = pwc_visual_editor_sanitize_paragraph_attributes($content);
  }

  return $content;
}

/**
 * Sanitize attributes on paragraph HTML tags.
 *
 * @param string $html
 *   HTML content with allowed tags.
 *
 * @return string
 *   HTML with sanitized attributes.
 */
function pwc_visual_editor_sanitize_paragraph_attributes(string $html): string {
  // Wrap in a root element to ensure valid parsing
  $wrapped = '<div>' . $html . '</div>';

  $dom = new \DOMDocument();
  @$dom->loadHTML('<?xml encoding="UTF-8">' . $wrapped, LIBXML_HTML_NOIMPLIED | LIBXML_HTML_NODEFDTD);

  // Allowed attributes per tag
  $allowed_attributes = [
    'p' => ['class'],
    'a' => ['href', 'title', 'target', 'rel'],
    'span' => ['class'],
    'strong' => [],
    'em' => [],
    'b' => [],
    'i' => [],
    'br' => [],
    'sub' => [],
    'sup' => [],
    'mark' => [],
    'code' => ['class'],
  ];

  // Dangerous attribute patterns
  $dangerous_patterns = [
    '/^on/i',
    '/^javascript:/i',
    '/^vbscript:/i',
    '/^data:/i',
  ];

  $xpath = new \DOMXPath($dom);
  $elements = $xpath->query('//*');

  foreach ($elements as $element) {
    if (!$element instanceof \DOMElement) {
      continue;
    }

    $tagName = strtolower($element->tagName);

    if ($tagName === 'div' || $tagName === 'body' || $tagName === 'html') {
      continue;
    }

    $tagAllowed = $allowed_attributes[$tagName] ?? [];
    $attributesToRemove = [];

    foreach ($element->attributes as $attr) {
      $attrName = strtolower($attr->name);
      $attrValue = $attr->value;

      if (!in_array($attrName, $tagAllowed)) {
        $attributesToRemove[] = $attr->name;
        continue;
      }

      foreach ($dangerous_patterns as $pattern) {
        if (preg_match($pattern, $attrValue)) {
          $attributesToRemove[] = $attr->name;
          break;
        }
      }

      if ($attrName === 'href') {
        $parsed = parse_url($attrValue);
        $scheme = strtolower($parsed['scheme'] ?? '');
        if ($scheme && !in_array($scheme, ['http', 'https', 'mailto', 'tel'])) {
          $attributesToRemove[] = $attr->name;
        }
      }
    }

    foreach ($attributesToRemove as $attrName) {
      $element->removeAttribute($attrName);
    }

    if ($tagName === 'a' && $element->hasAttribute('href')) {
      $href = $element->getAttribute('href');
      if (strpos($href, 'http') === 0) {
        $element->setAttribute('rel', 'noopener noreferrer');
      }
    }
  }

  $result = '';
  $wrapper = $dom->getElementsByTagName('div')->item(0);
  if ($wrapper) {
    foreach ($wrapper->childNodes as $child) {
      $result .= $dom->saveHTML($child);
    }
  }

  return $result ?: $html;
}

/**
 * Render a button block.
 *
 * @param array $attributes
 *   Block attributes.
 *
 * @return string
 *   Rendered HTML.
 */
function pwc_visual_editor_render_button(array $attributes): string {
  $label = htmlspecialchars($attributes['label'] ?? 'Button');
  $btnType = $attributes['btnType'] ?? 'primary';

  // Validate button type
  $validTypes = ['primary', 'secondary', 'tertiary', 'text', 'negative'];
  if (!in_array($btnType, $validTypes)) {
    $btnType = 'primary';
  }

  $icon = htmlspecialchars($attributes['icon'] ?? '');
  $compact = !empty($attributes['compact']) && $attributes['compact'] !== 'false';
  $rounded = !empty($attributes['rounded']) && $attributes['rounded'] !== 'false';
  $url = $attributes['url'] ?? '';
  $target = !empty($attributes['target']) && $attributes['target'] !== 'false';

  // Build wrapper classes
  $wrapperClasses = ['pwc-button-wrapper'];

  if (!empty($attributes['textAlign'])) {
    $wrapperClasses[] = htmlspecialchars($attributes['textAlign']);
  }
  if (!empty($attributes['margin'])) {
    $wrapperClasses[] = htmlspecialchars($attributes['margin']);
  }
  if (!empty($attributes['padding'])) {
    $wrapperClasses[] = htmlspecialchars($attributes['padding']);
  }
  if (!empty($attributes['customClasses'])) {
    $wrapperClasses[] = htmlspecialchars($attributes['customClasses']);
  }

  $wrapperClassString = implode(' ', array_filter($wrapperClasses));

  // Build <apw-button> attributes
  $btnAttrs = 'btn-type="' . htmlspecialchars($btnType) . '" label="' . $label . '" type="button"';
  if ($icon) {
    $btnAttrs .= ' icon="' . $icon . '"';
  }
  if ($compact) {
    $btnAttrs .= ' compact="true"';
  }
  if ($rounded) {
    $btnAttrs .= ' rounded="true"';
  }

  $buttonHtml = "<apw-button {$btnAttrs}></apw-button>";

  // Wrap in link if URL provided
  if (!empty($url)) {
    // Validate URL - only allow http, https, mailto, tel
    $scheme = parse_url($url, PHP_URL_SCHEME);
    $allowedSchemes = ['http', 'https', 'mailto', 'tel', NULL];
    if (!in_array($scheme, $allowedSchemes)) {
      $url = '#';
    }
    $safeUrl = htmlspecialchars($url, ENT_QUOTES, 'UTF-8');
    $targetAttr = $target ? ' target="_blank" rel="noopener noreferrer"' : '';
    $buttonHtml = "<a href=\"{$safeUrl}\" class=\"pwc-button-link\"{$targetAttr}>{$buttonHtml}</a>";
  }

  return "<div class=\"{$wrapperClassString}\">{$buttonHtml}</div>\n";
}

/**
 * Render a tag block.
 *
 * @param array $attributes
 *   Block attributes.
 *
 * @return string
 *   Rendered HTML.
 */
function pwc_visual_editor_render_tag(array $attributes): string {
  $tagsStr = $attributes['tags'] ?? 'Tag 1, Tag 2, Tag 3';
  $size = $attributes['size'] ?? 'small';
  $tagType = $attributes['tagType'] ?? 'filled';
  $showClose = !empty($attributes['showClose']) && $attributes['showClose'] !== 'false';
  $stacked = !empty($attributes['stacked']) && $attributes['stacked'] !== 'false';
  $backgroundColor = $attributes['backgroundColor'] ?? '';
  $fontColor = $attributes['fontColor'] ?? '';

  // Validate size
  if (!in_array($size, ['small', 'large'])) {
    $size = 'small';
  }

  // Validate type
  if (!in_array($tagType, ['filled', 'outlined'])) {
    $tagType = 'filled';
  }

  // Build wrapper classes
  $wrapperClasses = ['pwc-tag-wrapper'];

  if (!empty($attributes['textAlign'])) {
    $wrapperClasses[] = htmlspecialchars($attributes['textAlign']);
  }
  if (!empty($attributes['margin'])) {
    $wrapperClasses[] = htmlspecialchars($attributes['margin']);
  }
  if (!empty($attributes['padding'])) {
    $wrapperClasses[] = htmlspecialchars($attributes['padding']);
  }
  if (!empty($attributes['customClasses'])) {
    $wrapperClasses[] = htmlspecialchars($attributes['customClasses']);
  }

  $wrapperClassString = implode(' ', array_filter($wrapperClasses));

  // Parse comma-separated tags
  $tags = array_filter(array_map('trim', explode(',', $tagsStr)));

  if (empty($tags)) {
    return '';
  }

  // Build each <apw-tag>
  $tagsHtml = '';
  foreach ($tags as $text) {
    $safeText = htmlspecialchars($text, ENT_QUOTES, 'UTF-8');
    $attrs = "text=\"{$safeText}\" size=\"{$size}\" type=\"{$tagType}\" show-close=\"" . ($showClose ? 'true' : 'false') . "\" apw-disabled=\"false\"";
    if ($backgroundColor) {
      $attrs .= ' background-color="' . htmlspecialchars($backgroundColor, ENT_QUOTES, 'UTF-8') . '"';
    }
    if ($fontColor) {
      $attrs .= ' font-color="' . htmlspecialchars($fontColor, ENT_QUOTES, 'UTF-8') . '"';
    }
    $tagsHtml .= "<li><apw-tag {$attrs}></apw-tag></li>";
  }

  $listClasses = 'pwc-tag-list' . ($stacked ? ' pwc-tag-list--stacked' : '');

  return "<div class=\"{$wrapperClassString}\"><ul class=\"{$listClasses}\">{$tagsHtml}</ul></div>\n";
}

/**
 * Get the view-mode CSS required for a given block type inside shadow DOM.
 *
 * Returns only the structural/utility styles that won't be available
 * when content is rendered inside a web component's shadow DOM.
 *
 * @param string $type
 *   Block type name (heading, paragraph, list, button, tag).
 *
 * @return string
 *   CSS rules for that block type, or empty string if none needed.
 */
function pwc_visual_editor_get_block_css(string $type): string {
  static $css = [
    'heading' => '
      .pwc-heading { display: block; }
    ',
    'paragraph' => '
      .pwc-paragraph { position: relative; }
      .pwc-paragraph__text { margin: 0; }
      .pwc-paragraph p { margin: 0; }
      .pwc-paragraph p + p { margin-top: 1em; }
      .pwc-paragraph p[data-indent="1"] { padding-left: 2em; }
      .pwc-paragraph p[data-indent="2"] { padding-left: 4em; }
      .pwc-paragraph p[data-indent="3"] { padding-left: 6em; }
      .pwc-paragraph p[data-indent="4"] { padding-left: 8em; }
    ',
    'list' => '
      .pwc-list__items { position: relative; }
      .pwc-list__items.pwc-list-outside { padding-left: 1.5em; }
      .pwc-list__item { position: relative; }
      .pwc-list__items ul, .pwc-list__items ol { padding-left: 1.5em; margin-top: 0.25em; }
      .pwc-list__items ul { list-style-type: circle; }
      .pwc-list__items ul ul { list-style-type: square; }
      .pwc-list__items ol ol { list-style-type: lower-alpha; }
      .pwc-list__items ol ol ol { list-style-type: lower-roman; }
      .pwc-list-disc { list-style-type: disc; }
      .pwc-list-circle { list-style-type: circle; }
      .pwc-list-square { list-style-type: square; }
      .pwc-list-decimal { list-style-type: decimal; }
      .pwc-list-decimal-leading-zero { list-style-type: decimal-leading-zero; }
      .pwc-list-lower-alpha { list-style-type: lower-alpha; }
      .pwc-list-upper-alpha { list-style-type: upper-alpha; }
      .pwc-list-lower-roman { list-style-type: lower-roman; }
      .pwc-list-upper-roman { list-style-type: upper-roman; }
      .pwc-list-none { list-style-type: none; }
      .pwc-list-outside { list-style-position: outside; }
      .pwc-list-inside { list-style-position: inside; }
    ',
    'button' => '
      .pwc-button-wrapper { position: relative; }
      .pwc-button-link { text-decoration: none; display: inline-block; }
    ',
    'tag' => '
      .pwc-tag-wrapper { position: relative; }
      .pwc-tag-list { list-style-type: none; padding-inline-start: 0; margin-left: 0; display: flex; flex-wrap: wrap; gap: 8px; }
      .pwc-tag-list--stacked { flex-direction: column; }
    ',
    'layout' => '
      .pwc-layout-block { display: flex; flex-wrap: wrap; width: 100%; min-width: 0; }
      .pwc-layout-column { display: flex; min-width: 0; }
      .pwc-layout-column__content { flex: 1; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
    ',
  ];

  return $css[$type] ?? '';
}

/**
 * Get shared utility CSS needed by all block types inside shadow DOM.
 *
 * These are layout/typography utilities that any block might reference
 * via its attributes.
 *
 * @return string
 *   Utility CSS rules.
 */
function pwc_visual_editor_get_utility_css(): string {
  return '
    .ap-font-48 { font-size: 48px; }
    .ap-font-36 { font-size: 36px; }
    .ap-font-30 { font-size: 30px; }
    .ap-font-20 { font-size: 20px; }
    .ap-font-18 { font-size: 18px; }
    .ap-font-16 { font-size: 16px; }
    .ap-font-weight-2 { font-weight: 600; }
    .pwc-text-left { text-align: left; }
    .pwc-text-center { text-align: center; }
    .pwc-text-right { text-align: right; }
    .pwc-text-justify { text-align: justify; }
    .pwc-leading-none { line-height: 1; }
    .pwc-leading-tight { line-height: 1.25; }
    .pwc-leading-snug { line-height: 1.375; }
    .pwc-leading-normal { line-height: 1.5; }
    .pwc-leading-relaxed { line-height: 1.625; }
    .pwc-leading-loose { line-height: 2; }
    .pwc-space-y-0 > * + * { margin-top: 0; }
    .pwc-space-y-1 > * + * { margin-top: 0.25rem; }
    .pwc-space-y-2 > * + * { margin-top: 0.5rem; }
    .pwc-space-y-3 > * + * { margin-top: 0.75rem; }
    .pwc-space-y-4 > * + * { margin-top: 1rem; }
    .pwc-space-y-6 > * + * { margin-top: 1.5rem; }
    .pwc-space-y-8 > * + * { margin-top: 2rem; }
    .pwc-layout-gap-none { gap: 0; }
    .pwc-layout-gap-small { gap: 8px; }
    .pwc-layout-gap-medium { gap: 16px; }
    .pwc-layout-gap-large { gap: 24px; }
    .pwc-layout-align-top { align-items: flex-start; }
    .pwc-layout-align-center { align-items: center; }
    .pwc-layout-align-bottom { align-items: flex-end; }
    .pwc-layout-align-stretch { align-items: stretch; }
    .pwc-layout-column--grow-1 { flex: 1 0 0; }
    .pwc-layout-column--grow-2 { flex: 2 0 0; }
    .pwc-layout-column--grow-3 { flex: 3 0 0; }
    .pwc-layout-column--grow-4 { flex: 4 0 0; }
    .pwc-layout-column--grow-5 { flex: 5 0 0; }
    .pwc-layout-column--grow-6 { flex: 6 0 0; }
    .pwc-layout-column--grow-7 { flex: 7 0 0; }
    .pwc-layout-column--grow-8 { flex: 8 0 0; }
    .pwc-layout-column--grow-9 { flex: 9 0 0; }
    .pwc-layout-column--grow-10 { flex: 10 0 0; }
  ';
}

/**
 * Recursively collect block type names from a block tree.
 *
 * @param array $blocks
 *   Blocks in editor serialized format.
 *
 * @return array
 *   Flat list of block type names.
 */
function pwc_visual_editor_collect_block_types(array $blocks): array {
  $types = [];
  foreach ($blocks as $block) {
    $type = $block['type'] ?? '';
    if ($type !== '') {
      $types[] = $type;
    }
    if (!empty($block['innerBlocks']) && is_array($block['innerBlocks'])) {
      $types = array_merge($types, pwc_visual_editor_collect_block_types($block['innerBlocks']));
    }
  }
  return $types;
}

/**
 * Build a <style> tag with only the CSS needed for the given block types.
 *
 * @param array $blockTypes
 *   Array of block type names present in the accordion.
 *
 * @return string
 *   A <style> element, or empty string if no CSS is needed.
 */
function pwc_visual_editor_build_shadow_style(array $blockTypes): string {
  $css = '';
  $seen = [];

  foreach ($blockTypes as $type) {
    if (isset($seen[$type])) {
      continue;
    }
    $seen[$type] = TRUE;
    $css .= pwc_visual_editor_get_block_css($type);
  }

  if (empty($css)) {
    return '';
  }

  // Include utility CSS once (text align, line height, spacing)
  $css .= pwc_visual_editor_get_utility_css();

  // Minify: collapse whitespace
  $css = preg_replace('/\s+/', ' ', trim($css));

  return '<style>' . $css . '</style>';
}

/**
 * Render an accordion block (container block).
 *
 * @param array $attributes
 *   Block attributes including JSON 'titles' array.
 * @param array $innerBlocks
 *   Inner blocks grouped by columnIndex (accordion section index).
 *
 * @return string
 *   Rendered HTML using apw-accordion-group / apw-accordion.
 */
function pwc_visual_editor_render_accordion(array $attributes, array $innerBlocks): string {
  $titlesJson = $attributes['titles'] ?? '[]';
  $titles = json_decode($titlesJson, TRUE);

  if (!is_array($titles) || empty($titles)) {
    return '';
  }

  $multiple = !empty($attributes['multiple']) && $attributes['multiple'] !== 'false';
  $zebraStripes = !empty($attributes['zebraStripes']) && $attributes['zebraStripes'] !== 'false';

  // Parse customHeaders attribute
  $customHeadersJson = $attributes['customHeaders'] ?? '[]';
  $customHeaders = json_decode($customHeadersJson, TRUE) ?: [];

  // Build wrapper classes
  $wrapperClasses = ['pwc-accordion-wrapper'];

  if (!empty($attributes['margin'])) {
    $wrapperClasses[] = htmlspecialchars($attributes['margin']);
  }
  if (!empty($attributes['padding'])) {
    $wrapperClasses[] = htmlspecialchars($attributes['padding']);
  }
  if (!empty($attributes['customClasses'])) {
    $wrapperClasses[] = htmlspecialchars($attributes['customClasses']);
  }

  $wrapperClassString = implode(' ', array_filter($wrapperClasses));

  // Separate header blocks from body blocks and collect block types
  $bodyBlocksBySection = [];
  $headerBlocksBySection = [];
  $allBlockTypes = [];
  foreach ($innerBlocks as $block) {
    $sectionIndex = (int) ($block['attributes']['columnIndex'] ?? 0);
    $allBlockTypes = array_merge($allBlockTypes, pwc_visual_editor_collect_block_types([$block]));
    if (!empty($block['attributes']['headerBlock'])) {
      $headerBlocksBySection[$sectionIndex][] = $block;
    } else {
      $bodyBlocksBySection[$sectionIndex][] = $block;
    }
  }

  // Build a single <style> tag with CSS for all block types in this accordion
  $shadowStyle = pwc_visual_editor_build_shadow_style($allBlockTypes);

  // Build accordion sections
  $accordionsHtml = '';
  foreach ($titles as $index => $title) {
    $expanded = $index === 0 ? ' expanded="true"' : '';
    $isCustom = !empty($customHeaders[$index]) || !empty($headerBlocksBySection[$index]);
    $zebraStyle = ($zebraStripes && $index % 2 === 1) ? ' style="background-color:#f9fafb"' : '';

    if ($isCustom && !empty($headerBlocksBySection[$index])) {
      // Custom header: render blocks into extra-accordion-title
      $headerHtml = $shadowStyle;
      $headerHtml .= '<style>
        .ap-accordion-title{
          display:block!important;
          min-width:0!important;
          max-width:none!important;
          width:100%!important;
          height:auto!important;
          white-space:normal!important;
          overflow:visible!important;
          text-overflow:clip!important;
          margin-right:0!important;
        }
        .ap-accordion-toggle{
          position:relative!important;
          display:block!important;
          align-items:initial!important;
          padding-right:2.25rem!important;
        }
        .ap-accordion-toggle-icon-container{
          position:absolute!important;
          right:0!important;
          top:0.25rem!important;
          width:auto!important;
          max-width:max-content!important;
          margin-left:0!important;
        }
      </style>';
      $headerHtml .= '<div class="pwc-accordion-extra-title" style="display:block;width:100%;min-width:0;max-width:100%;flex:1 1 auto;">';
      foreach ($headerBlocksBySection[$index] as $headerBlock) {
        $headerHtml .= pwc_visual_editor_render_block($headerBlock);
      }
      $headerHtml .= '</div>';
      $safeHeaderHtml = htmlspecialchars($headerHtml, ENT_QUOTES, 'UTF-8');
      $accordionsHtml .= '<apw-accordion accordion-title="" extra-accordion-title="' . $safeHeaderHtml . '"' . $expanded . $zebraStyle . '>';
    } else {
      // Text header (default)
      $safeTitle = htmlspecialchars($title, ENT_QUOTES, 'UTF-8');
      $accordionsHtml .= '<apw-accordion accordion-title="' . $safeTitle . '"' . $expanded . $zebraStyle . '>';
    }

    // Body blocks (slotted content stays in light DOM, styled by blocks.css)
    $accordionsHtml .= '<div slot="body">';
    if (!empty($bodyBlocksBySection[$index])) {
      foreach ($bodyBlocksBySection[$index] as $innerBlock) {
        $accordionsHtml .= pwc_visual_editor_render_block($innerBlock);
      }
    }
    $accordionsHtml .= '</div>';
    $accordionsHtml .= '</apw-accordion>';
  }

  $multipleAttr = $multiple ? ' multiple="true"' : '';

  return '<div class="' . $wrapperClassString . '">'
    . '<apw-accordion-group' . $multipleAttr . '>'
    . $accordionsHtml
    . '</apw-accordion-group>'
    . "</div>\n";
}

/**
 * Render a tab block (container block).
 *
 * @param array $attributes
 *   Block attributes including JSON 'titles' array.
 * @param array $innerBlocks
 *   Inner blocks grouped by columnIndex (tab panel index).
 *
 * @return string
 *   Rendered HTML using apw-tabset / apw-tab.
 */
function pwc_visual_editor_render_tab(array $attributes, array $innerBlocks): string {
  $titlesJson = $attributes['titles'] ?? '[]';
  $titles = json_decode($titlesJson, TRUE);

  if (!is_array($titles) || empty($titles)) {
    return '';
  }

  $tabType = htmlspecialchars($attributes['tabType'] ?? 'underline');
  $stretched = (!empty($attributes['stretched']) && $attributes['stretched'] !== 'false')
    ? ' stretched="true"' : '';
  $contentBgColor = $attributes['contentBgColor'] ?? '';

  // Wrapper classes
  $wrapperClasses = ['pwc-tab-wrapper'];
  if (!empty($attributes['margin'])) {
    $wrapperClasses[] = htmlspecialchars($attributes['margin']);
  }
  if (!empty($attributes['padding'])) {
    $wrapperClasses[] = htmlspecialchars($attributes['padding']);
  }
  if (!empty($attributes['customClasses'])) {
    $wrapperClasses[] = htmlspecialchars($attributes['customClasses']);
  }

  // Group blocks by tab index
  $blocksByTab = [];
  foreach ($innerBlocks as $block) {
    $tabIndex = (int) ($block['attributes']['columnIndex'] ?? 0);
    $blocksByTab[$tabIndex][] = $block;
  }

  // Build tabs
  $tabsHtml = '';
  foreach ($titles as $index => $title) {
    $safeTitle = htmlspecialchars($title, ENT_QUOTES, 'UTF-8');
    $tabsHtml .= '<apw-tab label="' . $safeTitle . '">';

    // Content wrapper with background color
    $contentClasses = $contentBgColor ? ' class="' . htmlspecialchars($contentBgColor) . '"' : '';
    $tabsHtml .= '<div' . $contentClasses . '>';
    if (!empty($blocksByTab[$index])) {
      foreach ($blocksByTab[$index] as $innerBlock) {
        $tabsHtml .= pwc_visual_editor_render_block($innerBlock);
      }
    }
    $tabsHtml .= '</div>';
    $tabsHtml .= '</apw-tab>';
  }

  $wrapperClassString = implode(' ', $wrapperClasses);

  return '<div class="' . $wrapperClassString . '">'
    . '<apw-tabset type="' . $tabType . '"' . $stretched . '>'
    . $tabsHtml
    . '</apw-tabset>'
    . "</div>\n";
}

/**
 * Render a layout block.
 *
 * @param array $attributes
 *   Block attributes.
 * @param array $innerBlocks
 *   Inner blocks (columns).
 *
 * @return string
 *   Rendered HTML.
 */
function pwc_visual_editor_render_layout(array $attributes, array $innerBlocks): string {
  // Skip rendering empty layout blocks in SSR
  if (empty($innerBlocks)) {
    return '';
  }

  $layout = $attributes['layout'] ?? '100';
  $gap = $attributes['gap'] ?? 'medium';
  $verticalAlign = $attributes['verticalAlign'] ?? 'top';

  // Layout configurations matching JS layoutVariations (flex-grow ratios).
  $layoutConfigs = [
    '100' => [1],
    '50-50' => [1, 1],
    '30-70' => [3, 7],
    '70-30' => [7, 3],
    '33-33-33' => [1, 1, 1],
    '25-50-25' => [1, 2, 1],
    // Legacy layout names for backwards compatibility.
    'equal' => [],
    '1-2' => [1, 2],
    '2-1' => [2, 1],
    '1-2-1' => [1, 2, 1],
    '1-3' => [1, 3],
    '3-1' => [3, 1],
  ];

  // Gap values matching JS gapValues.
  $gapValues = [
    'none' => '0',
    'small' => '8px',
    'medium' => '16px',
    'large' => '24px',
    // Legacy numeric gap values.
    '0' => '0',
    '1' => '0.25rem',
    '2' => '0.5rem',
    '3' => '0.75rem',
    '4' => '1rem',
    '5' => '1.25rem',
    '6' => '1.5rem',
    '8' => '2rem',
  ];

  // Vertical alignment values matching JS.
  $alignValues = [
    'top' => 'flex-start',
    'center' => 'center',
    'bottom' => 'flex-end',
    'stretch' => 'stretch',
  ];

  $flexRatios = $layoutConfigs[$layout] ?? [];
  $columns = !empty($flexRatios) ? count($flexRatios) : (int) ($attributes['columns'] ?? 2);

  // For legacy 'equal' layout, fill with 1s.
  if (empty($flexRatios)) {
    $flexRatios = array_fill(0, $columns, 1);
  }

  $gapValue = $gapValues[$gap] ?? '16px';
  $alignValue = $alignValues[$verticalAlign] ?? 'flex-start';

  // Build wrapper classes (no Tailwind — flex/wrap handled by .pwc-layout-block in CSS).
  $wrapperClasses = ['pwc-layout-block'];
  if (!empty($attributes['margin'])) {
    $wrapperClasses[] = htmlspecialchars($attributes['margin']);
  }
  if (!empty($attributes['padding'])) {
    $wrapperClasses[] = htmlspecialchars($attributes['padding']);
  }
  if (!empty($attributes['backgroundColor'])) {
    $wrapperClasses[] = htmlspecialchars($attributes['backgroundColor']);
  }
  if (!empty($attributes['borderWidth'])) {
    $wrapperClasses[] = htmlspecialchars($attributes['borderWidth']);
  }
  if (!empty($attributes['borderColor'])) {
    $wrapperClasses[] = htmlspecialchars($attributes['borderColor']);
  }
  if (!empty($attributes['borderRadius'])) {
    $wrapperClasses[] = htmlspecialchars($attributes['borderRadius']);
  }
  if (!empty($attributes['customClasses'])) {
    $wrapperClasses[] = htmlspecialchars($attributes['customClasses']);
  }
  $wrapperClasses[] = 'pwc-layout-gap-' . preg_replace('/[^a-z0-9-]/', '', strtolower((string) $gap));
  $wrapperClasses[] = 'pwc-layout-align-' . preg_replace('/[^a-z0-9-]/', '', strtolower((string) $verticalAlign));

  $wrapperClassString = implode(' ', $wrapperClasses);
  $wrapperStyle = "gap: {$gapValue}; align-items: {$alignValue};";

  // Group inner blocks by columnIndex.
  $blocksByColumn = [];
  for ($i = 0; $i < $columns; $i++) {
    $blocksByColumn[$i] = [];
  }

  foreach ($innerBlocks as $block) {
    $columnIndex = (int) ($block['attributes']['columnIndex'] ?? 0);
    if ($columnIndex >= $columns) {
      $columnIndex = 0;
    }
    $blocksByColumn[$columnIndex][] = $block;
  }

  $html = "<div class=\"{$wrapperClassString}\" style=\"{$wrapperStyle}\">\n";

  // Render each column using flex-grow ratios (matching JS inline styles).
  for ($columnIndex = 0; $columnIndex < $columns; $columnIndex++) {
    $flex = $flexRatios[$columnIndex] ?? 1;
    $columnStyle = "flex: {$flex} 0 0;";
    $safeFlex = max(1, min(10, (int) $flex));
    $columnClass = "pwc-layout-column pwc-layout-column--grow-{$safeFlex}";

    $html .= "  <div class=\"{$columnClass}\" style=\"{$columnStyle}\">\n";
    $html .= "    <div class=\"pwc-layout-column__content\">\n";

    foreach ($blocksByColumn[$columnIndex] as $innerBlock) {
      $html .= '      ' . pwc_visual_editor_render_block($innerBlock);
    }

    $html .= "    </div>\n";
    $html .= "  </div>\n";
  }

  $html .= "</div>\n";

  return $html;
}

/**
 * Get flex-grow ratio for a column based on layout.
 *
 * @param string $layout
 *   Layout type (100, 50-50, 30-70, 70-30, 33-33-33, 25-50-25).
 * @param int $index
 *   Column index.
 * @param int $totalColumns
 *   Total number of columns.
 *
 * @return int
 *   Flex-grow ratio for the column.
 *
 * @deprecated No longer used directly by render_layout. Kept for reference.
 */
function pwc_visual_editor_get_column_width_class(string $layout, int $index, int $totalColumns): string {
  // Layout patterns with flex-grow ratios matching JS layoutVariations.
  $layouts = [
    '50-50' => [1, 1],
    '30-70' => [3, 7],
    '70-30' => [7, 3],
    '33-33-33' => [1, 1, 1],
    '25-50-25' => [1, 2, 1],
    // Legacy layout names.
    '1-2' => [1, 2],
    '2-1' => [2, 1],
    '1-2-1' => [1, 2, 1],
    '1-3' => [1, 3],
    '3-1' => [3, 1],
  ];

  if (!isset($layouts[$layout])) {
    return '1';
  }

  return (string) ($layouts[$layout][$index] ?? 1);
}

/**
 * Implements hook_menu_local_tasks_alter().
 *
 * Hide View/Edit/Delete/Revisions tabs on Visual Pages.
 */
function pwc_visual_editor_menu_local_tasks_alter(&$data, $route_name, \Drupal\Core\Cache\RefinableCacheableDependencyInterface &$cacheability) {
  // Only process on node routes
  $route_match = \Drupal::routeMatch();
  $node = $route_match->getParameter('node');

  if (!$node instanceof NodeInterface) {
    return;
  }

  // Only hide tabs for visual_page content type
  if ($node->bundle() !== 'visual_page') {
    return;
  }

  // Remove all local tasks (tabs) for Visual Pages
  $data['tabs'] = [];
}

/**
 * Implements hook_preprocess_page().
 *
 * Add class to body for Visual Pages to enable CSS hiding.
 */
function pwc_visual_editor_preprocess_page(&$variables) {
  $route_match = \Drupal::routeMatch();
  $node = $route_match->getParameter('node');

  if ($node instanceof NodeInterface && $node->bundle() === 'visual_page') {
    $variables['#attached']['library'][] = 'pwc_visual_editor/visual_page';
  }
}
