{#
/**
 * @file
 * Template for editing a Visual Page.
 *
 * Available variables:
 * - node: The node being edited.
 * - content: The existing block content (array).
 */
#}
<div class="pwc-visual-editor-page pwc-editing ap-bg-color-background-default" data-pwc-node-id="{{ node.id }}">
  <!-- Page Header -->
  <div class="pwc-page-header ap-bg-color-background-container pwc-u-flex pwc-u-items-center pwc-u-justify-between">
    <div class="pwc-page-header__left pwc-u-flex pwc-u-items-center">
      <a href="{{ path('entity.node.canonical', {'node': node.id}) }}" class="pwc-page-header__back pwc-u-icon-btn pwc-u-icon-btn--ghost ap-text-color-text-body" title="View page">
        <svg class="pwc-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
      </a>
      <input
        type="text"
        id="pwc-page-title"
        class="pwc-page-header__title ap-text-color-text-heading"
        placeholder="Enter page title..."
        value="{{ node.label }}"
      >
    </div>
    <div class="pwc-page-header__right pwc-u-flex pwc-u-items-center">
      <span id="pwc-save-status" class="pwc-page-header__status hidden ap-text-color-text-light">
        Saving...
      </span>
      <a href="{{ path('entity.node.canonical', {'node': node.id}) }}" class="pwc-page-header__cancel pwc-u-btn pwc-u-btn--ghost ap-text-color-text-body">
        Cancel
      </a>
      <button
        type="button"
        id="pwc-save-btn"
        class="pwc-page-header__save pwc-u-btn pwc-u-btn--primary ap-bg-color-background-primary ap-text-color-text-secondary"
      >
        Save Changes
      </button>
    </div>
  </div>

  <!-- Editor Canvas -->
  <div class="pwc-editor-canvas">
    <div class="pwc-editor-canvas__inner">
      <!-- Debug: Show content from Twig for debugging -->
      <div id="pwc-debug-info" class="pwc-debug-info">
        <strong>Debug Info (remove later):</strong><br>
        <strong>FROM TWIG (PHP):</strong><br>
        - Node ID: {{ node.id }}<br>
        - Content is defined: {{ content is defined ? 'YES' : 'NO' }}<br>
        - Content is empty: {{ content is empty ? 'YES' : 'NO' }}<br>
        - Content type: {{ content is iterable ? 'array/iterable' : 'other' }}<br>
        - Content JSON: <code>{{ content|json_encode|raw }}</code><br>
        {% if content.blocks is defined %}
        - Blocks count: {{ content.blocks|length }}<br>
        {% else %}
        - Blocks: NOT DEFINED<br>
        {% endif %}
        <hr>
        <strong>FROM JAVASCRIPT:</strong> <span id="js-debug-output">Loading...</span>
      </div>
      <script>
        // Immediate JavaScript debug output
        document.addEventListener('DOMContentLoaded', function() {
          var debugOutput = document.getElementById('js-debug-output');
          var settings = (typeof drupalSettings !== 'undefined' && drupalSettings.pwcVisualEditor)
                        ? drupalSettings.pwcVisualEditor
                        : null;
          if (settings) {
            var content = settings.content;
            var info = 'settings.content = ' + JSON.stringify(content) +
                       ', blocks count = ' + (content && content.blocks ? content.blocks.length : 'N/A');
            debugOutput.innerHTML = info;
          } else {
            debugOutput.innerHTML = 'drupalSettings.pwcVisualEditor is NOT defined';
          }
        });
      </script>

      <!-- Content Region -->
      <div class="pwc-editor-wrapper" data-pwc-content-region="true" data-node-id="{{ node.id }}">
        <!-- Existing blocks will be rendered here -->
      </div>
    </div>
  </div>

  <!-- Block Library Panel (Gutenberg-style) - opens by default in edit mode -->
  <pwc-block-library-panel></pwc-block-library-panel>

  <!-- Settings Panel -->
  <pwc-settings-panel></pwc-settings-panel>

  <!-- Block Toolbar (will be positioned dynamically) -->
  <pwc-block-toolbar></pwc-block-toolbar>

  <!-- Rich Text Toolbar -->
  <pwc-rich-text-toolbar></pwc-rich-text-toolbar>
</div>

<script>
  // Initialize editor in edit mode
  (function() {
    'use strict';

    /**
     * Wait for editor services to be ready.
     * @param {Function} callback - Callback to run when ready.
     */
    function waitForEditor(callback) {
      const settings = drupalSettings.pwcVisualEditor || {};

      function collectBlockTypes(blocks, types) {
        if (!Array.isArray(blocks)) return;
        blocks.forEach(function(block) {
          if (block && block.type) {
            types.add(block.type);
          }
          if (block && Array.isArray(block.innerBlocks) && block.innerBlocks.length > 0) {
            collectBlockTypes(block.innerBlocks, types);
          }
        });
      }

      const requiredTypes = new Set();
      const existingBlocks = settings.content && Array.isArray(settings.content.blocks)
        ? settings.content.blocks
        : [];
      collectBlockTypes(existingBlocks, requiredTypes);

      // Check if all required services are available
      function isReady() {
        if (!window.pwcEditorState || !window.pwcBlockRegistry) {
          return false;
        }

        const registryHasAny = window.pwcBlockRegistry.getAll().length > 0;
        if (!registryHasAny) {
          return false;
        }

        for (const type of requiredTypes) {
          if (!window.pwcBlockRegistry.get(type)) {
            return false;
          }
        }

        return true;
      }

      if (isReady()) {
        console.log('PWC Visual Editor: Services ready immediately');
        callback();
        return;
      }

      // Poll until ready (max 5 seconds)
      let attempts = 0;
      const maxAttempts = 50;
      const interval = setInterval(function() {
        attempts++;
        if (isReady()) {
          clearInterval(interval);
          console.log('PWC Visual Editor: Services ready after', attempts * 100, 'ms');
          callback();
        } else if (attempts >= maxAttempts) {
          clearInterval(interval);
          console.error('PWC Visual Editor: Timeout waiting for services');
          // Try to initialize anyway
          if (window.pwcEditorState) {
            callback();
          }
        }
      }, 100);
    }

    /**
     * Initialize the editor.
     */
    function initializeEditor() {
      const settings = drupalSettings.pwcVisualEditor || {};

      console.log('PWC Visual Editor: Initializing in edit mode');
      console.log('PWC Visual Editor: Full settings object:', settings);
      console.log('PWC Visual Editor: settings.content:', settings.content);
      console.log('PWC Visual Editor: Available blocks:', window.pwcBlockRegistry.getAll().map(b => b.name));

      // Initialize the editor state with existing content
      const existingContent = settings.content || { blocks: [] };
      console.log('PWC Visual Editor: Existing content:', existingContent);
      console.log('PWC Visual Editor: Blocks to load:', existingContent.blocks);
      console.log('PWC Visual Editor: Number of blocks:', existingContent.blocks ? existingContent.blocks.length : 0);

      window.pwcEditorState.initialize({
        blocks: existingContent.blocks || [],
        isEditing: true,
        isNewPage: false,
        nodeId: settings.nodeId
      });

      // Open block library panel by default in edit mode
      const blockLibraryPanel = document.querySelector('pwc-block-library-panel');

      if (blockLibraryPanel) {
        // Auto-open the panel in edit mode
        blockLibraryPanel.open();
        console.log('PWC Visual Editor: Block library panel opened');
      } else {
        console.error('PWC Visual Editor: Could not find block library panel');
      }

      // Handle save button
      const saveBtn = document.getElementById('pwc-save-btn');
      const titleInput = document.getElementById('pwc-page-title');
      const saveStatus = document.getElementById('pwc-save-status');

      if (saveBtn) {
        saveBtn.addEventListener('click', async function() {
          const title = titleInput.value.trim() || 'Untitled Page';
          const content = window.pwcEditorState ? window.pwcEditorState.getState() : { blocks: [] };

          console.log('PWC Visual Editor: Saving page with content:', content);

          try {
            saveBtn.disabled = true;
            saveBtn.textContent = 'Saving...';
            if (saveStatus) saveStatus.classList.remove('hidden');

            const response = await fetch(settings.saveUrl, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({
                title: title,
                content: content
              })
            });

            const result = await response.json();

            if (result.success) {
              // Reset dirty flag after successful save
              if (window.pwcEditorState) {
                window.pwcEditorState.isDirty = false;
              }
              saveBtn.textContent = 'Saved!';
              setTimeout(() => {
                saveBtn.textContent = 'Save Changes';
                saveBtn.disabled = false;
              }, 1500);
            } else {
              alert('Failed to save: ' + (result.error || 'Unknown error'));
              saveBtn.textContent = 'Save Changes';
              saveBtn.disabled = false;
            }

            if (saveStatus) saveStatus.classList.add('hidden');
          } catch (error) {
            console.error('Error saving page:', error);
            alert('Failed to save. Please try again.');
            saveBtn.textContent = 'Save Changes';
            saveBtn.disabled = false;
            if (saveStatus) saveStatus.classList.add('hidden');
          }
        });
      }
    }

    // Wait for DOM and then for editor services
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        waitForEditor(initializeEditor);
      });
    } else {
      waitForEditor(initializeEditor);
    }
  })();
</script>
