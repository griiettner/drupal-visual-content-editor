<?php

/**
 * @file
 * PWC Visual Editor module.
 *
 * Provides front-end visual content editing capabilities.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Url;
use Drupal\node\NodeInterface;

/**
 * Implements hook_help().
 */
function pwc_visual_editor_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.pwc_visual_editor':
      $output = '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('The PWC Visual Editor provides a front-end content editing experience similar to Webflow or WordPress Gutenberg.') . '</p>';
      $output .= '<h4>' . t('Creating Visual Pages') . '</h4>';
      $output .= '<p>' . t('Go to <a href="@url">/visual-editor/add</a> to create a new Visual Page.', ['@url' => '/visual-editor/add']) . '</p>';
      return $output;
  }
}

/**
 * Implements hook_page_attachments().
 */
function pwc_visual_editor_page_attachments(array &$attachments) {
  // Only attach on node pages
  $route_match = \Drupal::routeMatch();
  $node = $route_match->getParameter('node');

  if (!$node instanceof NodeInterface) {
    return;
  }

  // Only enable for visual_page content type
  if ($node->bundle() !== 'visual_page') {
    return;
  }

  // Check if user can edit
  $canEdit = \Drupal::currentUser()->hasPermission('use pwc visual editor') && $node->access('update');

  // Appkit4 CSS
  $attachments['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'link',
      '#attributes' => [
        'rel' => 'stylesheet',
        'href' => 'https://appkitcdn.pwc.com/appkit4/cdn/styles/4.10.3/appkit.min.css',
      ],
    ],
    'appkit4_css',
  ];

  // Appkit4 Web Components (ESM)
  $attachments['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'script',
      '#attributes' => [
        'type' => 'module',
        'src' => 'https://appkitcdn.pwc.com/appkit4/cdn/web-components/1.15.0/dist/appkit4/appkit4.esm.js',
      ],
    ],
    'appkit4_js',
  ];

  // Only attach editor library and settings if user can edit
  if ($canEdit) {
    // Load saved content for JS
    $content = [];
    if ($node->hasField('field_page_content') && !$node->get('field_page_content')->isEmpty()) {
      $json = $node->get('field_page_content')->value;
      $content = json_decode($json, TRUE) ?: [];
    }

    // Attach the editor library
    $attachments['#attached']['library'][] = 'pwc_visual_editor/editor';

    // Pass settings to JavaScript
    $attachments['#attached']['drupalSettings']['pwcVisualEditor'] = [
      'nodeId' => $node->id(),
      'nodeType' => $node->bundle(),
      'canEdit' => $canEdit,
      'content' => $content,
      'csrfToken' => \Drupal::csrfToken()->get('rest'),
      'saveUrl' => Url::fromRoute('pwc_visual_editor.save', ['node' => $node->id()])->toString(),
      'editUrl' => Url::fromRoute('pwc_visual_editor.edit', ['node' => $node->id()])->toString(),
      'viewMode' => TRUE,
    ];
  }
}

/**
 * Implements hook_theme().
 */
function pwc_visual_editor_theme($existing, $type, $theme, $path) {
  return [
    'pwc_visual_editor_wrapper' => [
      'variables' => [
        'content' => NULL,
        'node_id' => NULL,
      ],
      'template' => 'editor-wrapper',
    ],
    'pwc_visual_editor_add' => [
      'variables' => [],
      'template' => 'visual-editor-add',
    ],
    'pwc_visual_editor_edit' => [
      'variables' => [
        'node' => NULL,
        'content' => [],
      ],
      'template' => 'visual-editor-edit',
    ],
    'node__visual_page' => [
      'template' => 'node--visual-page',
      'base hook' => 'node',
    ],
  ];
}

/**
 * Implements hook_preprocess_node().
 */
function pwc_visual_editor_preprocess_node(&$variables) {
  $node = $variables['node'];

  // Only process visual_page content type
  if ($node->bundle() !== 'visual_page') {
    return;
  }

  // Load content for rendering
  $content = [];
  if ($node->hasField('field_page_content') && !$node->get('field_page_content')->isEmpty()) {
    $json = $node->get('field_page_content')->value;
    $content = json_decode($json, TRUE) ?: [];
  }

  // Check if user has permission to edit
  $canEdit = \Drupal::currentUser()->hasPermission('use pwc visual editor') && $node->access('update');
  $variables['can_edit'] = $canEdit;

  if ($canEdit) {
    // Admin mode: empty div for JavaScript to render into
    $variables['rendered_blocks'] = NULL;
    $variables['visual_editor_edit_url'] = Url::fromRoute('pwc_visual_editor.edit', ['node' => $node->id()])->toString();
  }
  else {
    // View mode: Server-side render the blocks as HTML
    $blocks = $content['blocks'] ?? [];
    $variables['rendered_blocks'] = pwc_visual_editor_render_blocks($blocks);
  }
}

/**
 * Sanitize inline HTML content, allowing only safe formatting tags.
 *
 * @param string $content
 *   Raw content that may contain HTML.
 *
 * @return string
 *   Sanitized HTML with only allowed tags.
 */
function pwc_visual_editor_sanitize_inline_html(string $content): string {
  // List of allowed inline formatting tags
  $allowed_tags = '<strong><em><b><i><a><span><br><sub><sup><mark><code>';

  // Strip all tags except allowed ones
  $content = strip_tags($content, $allowed_tags);

  // Sanitize attributes on allowed tags (especially important for <a> tags)
  // Use DOMDocument for more thorough sanitization
  if (strpos($content, '<') !== FALSE) {
    $content = pwc_visual_editor_sanitize_tag_attributes($content);
  }

  return $content;
}

/**
 * Sanitize attributes on HTML tags to prevent XSS.
 *
 * @param string $html
 *   HTML content with allowed tags.
 *
 * @return string
 *   HTML with sanitized attributes.
 */
function pwc_visual_editor_sanitize_tag_attributes(string $html): string {
  // Wrap in a root element to ensure valid parsing
  $wrapped = '<div>' . $html . '</div>';

  $dom = new \DOMDocument();
  // Suppress warnings for malformed HTML
  @$dom->loadHTML('<?xml encoding="UTF-8">' . $wrapped, LIBXML_HTML_NOIMPLIED | LIBXML_HTML_NODEFDTD);

  // Allowed attributes per tag
  $allowed_attributes = [
    'a' => ['href', 'title', 'target', 'rel'],
    'span' => ['class'],
    'strong' => [],
    'em' => [],
    'b' => [],
    'i' => [],
    'br' => [],
    'sub' => [],
    'sup' => [],
    'mark' => [],
    'code' => ['class'],
  ];

  // Dangerous attribute patterns (event handlers, javascript:, etc.)
  $dangerous_patterns = [
    '/^on/i',  // onclick, onerror, etc.
    '/^javascript:/i',
    '/^vbscript:/i',
    '/^data:/i',
  ];

  // Process all elements
  $xpath = new \DOMXPath($dom);
  $elements = $xpath->query('//*');

  foreach ($elements as $element) {
    if (!$element instanceof \DOMElement) {
      continue;
    }

    $tagName = strtolower($element->tagName);

    // Skip the wrapper div
    if ($tagName === 'div' || $tagName === 'body' || $tagName === 'html') {
      continue;
    }

    // Get allowed attributes for this tag
    $tagAllowed = $allowed_attributes[$tagName] ?? [];

    // Remove disallowed attributes
    $attributesToRemove = [];
    foreach ($element->attributes as $attr) {
      $attrName = strtolower($attr->name);
      $attrValue = $attr->value;

      // Check if attribute is allowed
      if (!in_array($attrName, $tagAllowed)) {
        $attributesToRemove[] = $attr->name;
        continue;
      }

      // Check for dangerous patterns in value
      foreach ($dangerous_patterns as $pattern) {
        if (preg_match($pattern, $attrValue)) {
          $attributesToRemove[] = $attr->name;
          break;
        }
      }

      // Special handling for href - only allow safe protocols
      if ($attrName === 'href') {
        $parsed = parse_url($attrValue);
        $scheme = strtolower($parsed['scheme'] ?? '');
        if ($scheme && !in_array($scheme, ['http', 'https', 'mailto', 'tel'])) {
          $attributesToRemove[] = $attr->name;
        }
      }
    }

    // Remove the disallowed attributes
    foreach ($attributesToRemove as $attrName) {
      $element->removeAttribute($attrName);
    }

    // Add rel="noopener noreferrer" to external links
    if ($tagName === 'a' && $element->hasAttribute('href')) {
      $href = $element->getAttribute('href');
      if (strpos($href, 'http') === 0) {
        $element->setAttribute('rel', 'noopener noreferrer');
      }
    }
  }

  // Extract the content without the wrapper
  $result = '';
  $wrapper = $dom->getElementsByTagName('div')->item(0);
  if ($wrapper) {
    foreach ($wrapper->childNodes as $child) {
      $result .= $dom->saveHTML($child);
    }
  }

  return $result ?: $html;
}

/**
 * Render blocks as HTML for server-side rendering.
 *
 * @param array $blocks
 *   Array of block data.
 *
 * @return string
 *   Rendered HTML string.
 */
function pwc_visual_editor_render_blocks(array $blocks): string {
  $html = '';

  foreach ($blocks as $block) {
    $html .= pwc_visual_editor_render_block($block);
  }

  return $html;
}

/**
 * Render a single block as HTML.
 *
 * @param array $block
 *   Block data with type, id, attributes, and optional innerBlocks.
 *
 * @return string
 *   Rendered HTML string.
 */
function pwc_visual_editor_render_block(array $block): string {
  $type = $block['type'] ?? '';
  $attributes = $block['attributes'] ?? [];
  $innerBlocks = $block['innerBlocks'] ?? [];

  switch ($type) {
    case 'heading':
      return pwc_visual_editor_render_heading($attributes);

    case 'paragraph':
      return pwc_visual_editor_render_paragraph($attributes);

    case 'list':
      return pwc_visual_editor_render_list($attributes);

    case 'layout':
      return pwc_visual_editor_render_layout($attributes, $innerBlocks);

    default:
      // Unknown block type - render as comment for debugging
      return '<!-- Unknown block type: ' . htmlspecialchars($type) . ' -->';
  }
}

/**
 * Render a heading block.
 *
 * @param array $attributes
 *   Block attributes.
 *
 * @return string
 *   Rendered HTML.
 */
function pwc_visual_editor_render_heading(array $attributes): string {
  // Allow safe inline formatting tags, sanitize the rest
  $content = pwc_visual_editor_sanitize_inline_html($attributes['content'] ?? 'Heading');
  $level = $attributes['level'] ?? 'h2';

  // Validate heading level
  if (!in_array($level, ['h1', 'h2', 'h3', 'h4', 'h5', 'h6'])) {
    $level = 'h2';
  }

  // Build class list from Tailwind utilities
  $classes = ['pwc-heading'];

  if (!empty($attributes['fontSize'])) {
    $classes[] = htmlspecialchars($attributes['fontSize']);
  }
  if (!empty($attributes['fontWeight'])) {
    $classes[] = htmlspecialchars($attributes['fontWeight']);
  }
  if (!empty($attributes['lineHeight'])) {
    $classes[] = htmlspecialchars($attributes['lineHeight']);
  }
  if (!empty($attributes['textAlign'])) {
    $classes[] = htmlspecialchars($attributes['textAlign']);
  }
  if (!empty($attributes['textColor'])) {
    $classes[] = htmlspecialchars($attributes['textColor']);
  }
  if (!empty($attributes['margin'])) {
    $classes[] = htmlspecialchars($attributes['margin']);
  }
  if (!empty($attributes['padding'])) {
    $classes[] = htmlspecialchars($attributes['padding']);
  }
  if (!empty($attributes['customClasses'])) {
    $classes[] = htmlspecialchars($attributes['customClasses']);
  }

  $classString = implode(' ', array_filter($classes));

  return "<{$level} class=\"{$classString}\">{$content}</{$level}>\n";
}

/**
 * Render a paragraph block.
 *
 * @param array $attributes
 *   Block attributes.
 *
 * @return string
 *   Rendered HTML.
 */
function pwc_visual_editor_render_paragraph(array $attributes): string {
  $content = $attributes['content'] ?? '';

  // Build container classes (gap, margin, padding, custom)
  $containerClasses = ['pwc-paragraph'];

  // Paragraph gap (default to space-y-4)
  $paragraphGap = $attributes['paragraphGap'] ?? 'space-y-4';
  if (!empty($paragraphGap)) {
    $containerClasses[] = htmlspecialchars($paragraphGap);
  }
  if (!empty($attributes['margin'])) {
    $containerClasses[] = htmlspecialchars($attributes['margin']);
  }
  if (!empty($attributes['padding'])) {
    $containerClasses[] = htmlspecialchars($attributes['padding']);
  }
  if (!empty($attributes['customClasses'])) {
    $containerClasses[] = htmlspecialchars($attributes['customClasses']);
  }

  // Build paragraph text classes
  $textClasses = ['pwc-paragraph__text'];

  if (!empty($attributes['fontSize'])) {
    $textClasses[] = htmlspecialchars($attributes['fontSize']);
  }
  if (!empty($attributes['fontWeight'])) {
    $textClasses[] = htmlspecialchars($attributes['fontWeight']);
  }
  if (!empty($attributes['lineHeight'])) {
    $textClasses[] = htmlspecialchars($attributes['lineHeight']);
  }
  if (!empty($attributes['textAlign'])) {
    $textClasses[] = htmlspecialchars($attributes['textAlign']);
  }
  if (!empty($attributes['textColor'])) {
    $textClasses[] = htmlspecialchars($attributes['textColor']);
  }

  $containerClassString = implode(' ', array_filter($containerClasses));
  $textClassString = implode(' ', array_filter($textClasses));

  // Convert <br><br> patterns to separate paragraphs
  $content = pwc_visual_editor_convert_double_br_to_paragraphs($content);

  // Check if content already has <p> tags
  if (strpos($content, '<p') !== FALSE) {
    // Content has paragraph tags - add classes to each <p>
    $content = preg_replace('/<p(\s|>)/', '<p class="' . $textClassString . '"$1', $content);
    // Sanitize the content (allow <p>, <br>, and inline formatting)
    $content = pwc_visual_editor_sanitize_paragraph_html($content);
    // Remove empty <p> tags
    $content = pwc_visual_editor_remove_empty_paragraphs($content);
  } else {
    // No paragraph tags - wrap in <p> and sanitize
    $content = pwc_visual_editor_sanitize_inline_html($content);
    if (trim($content)) {
      $content = "<p class=\"{$textClassString}\">{$content}</p>";
    } else {
      $content = '';
    }
  }

  // Don't render empty paragraph blocks
  if (!trim(strip_tags($content))) {
    return '';
  }

  return "<div class=\"{$containerClassString}\">{$content}</div>\n";
}

/**
 * Render a list block.
 *
 * @param array $attributes
 *   Block attributes.
 *
 * @return string
 *   Rendered HTML.
 */
function pwc_visual_editor_render_list(array $attributes): string {
  $content = $attributes['content'] ?? '<li>List item</li>';
  $listType = $attributes['listType'] ?? 'ul';

  // Validate list type
  if (!in_array($listType, ['ul', 'ol'])) {
    $listType = 'ul';
  }

  // Build list classes
  $listClasses = ['pwc-list__items'];

  // List style
  $listStyle = $attributes['listStyle'] ?? '';
  if (!empty($listStyle)) {
    $listClasses[] = htmlspecialchars($listStyle);
  }

  // List position
  $listPosition = $attributes['listPosition'] ?? 'list-outside';
  if (!empty($listPosition)) {
    $listClasses[] = htmlspecialchars($listPosition);
  }

  if (!empty($attributes['fontSize'])) {
    $listClasses[] = htmlspecialchars($attributes['fontSize']);
  }
  if (!empty($attributes['fontWeight'])) {
    $listClasses[] = htmlspecialchars($attributes['fontWeight']);
  }
  if (!empty($attributes['lineHeight'])) {
    $listClasses[] = htmlspecialchars($attributes['lineHeight']);
  }
  if (!empty($attributes['textAlign'])) {
    $listClasses[] = htmlspecialchars($attributes['textAlign']);
  }
  if (!empty($attributes['textColor'])) {
    $listClasses[] = htmlspecialchars($attributes['textColor']);
  }

  // Item gap
  $itemGap = $attributes['itemGap'] ?? 'space-y-2';
  if (!empty($itemGap)) {
    $listClasses[] = htmlspecialchars($itemGap);
  }

  if (!empty($attributes['margin'])) {
    $listClasses[] = htmlspecialchars($attributes['margin']);
  }
  if (!empty($attributes['padding'])) {
    $listClasses[] = htmlspecialchars($attributes['padding']);
  }
  if (!empty($attributes['customClasses'])) {
    $listClasses[] = htmlspecialchars($attributes['customClasses']);
  }

  $listClassString = implode(' ', array_filter($listClasses));

  // Sanitize list content - only allow <li> and inline formatting
  $content = pwc_visual_editor_sanitize_list_html($content);

  // Add classes to list items
  $content = preg_replace('/<li(\s|>)/', '<li class="pwc-list__item"$1', $content);

  // Don't render empty lists
  if (!trim(strip_tags($content))) {
    return '';
  }

  return "<{$listType} class=\"{$listClassString}\">{$content}</{$listType}>\n";
}

/**
 * Sanitize list HTML content, allowing only <li> and safe inline tags.
 *
 * @param string $content
 *   Raw content that may contain HTML.
 *
 * @return string
 *   Sanitized HTML with only allowed tags.
 */
function pwc_visual_editor_sanitize_list_html(string $content): string {
  // List of allowed tags for lists
  $allowed_tags = '<li><br><strong><em><b><i><a><span><sub><sup><mark><code>';

  // Strip all tags except allowed ones
  $content = strip_tags($content, $allowed_tags);

  // Sanitize attributes on allowed tags
  if (strpos($content, '<') !== FALSE) {
    $content = pwc_visual_editor_sanitize_list_attributes($content);
  }

  return $content;
}

/**
 * Sanitize attributes on list HTML tags.
 *
 * @param string $html
 *   HTML content with allowed tags.
 *
 * @return string
 *   HTML with sanitized attributes.
 */
function pwc_visual_editor_sanitize_list_attributes(string $html): string {
  // Wrap in a root element to ensure valid parsing
  $wrapped = '<div>' . $html . '</div>';

  $dom = new \DOMDocument();
  @$dom->loadHTML('<?xml encoding="UTF-8">' . $wrapped, LIBXML_HTML_NOIMPLIED | LIBXML_HTML_NODEFDTD);

  // Allowed attributes per tag
  $allowed_attributes = [
    'li' => ['class'],
    'a' => ['href', 'title', 'target', 'rel'],
    'span' => ['class'],
    'strong' => [],
    'em' => [],
    'b' => [],
    'i' => [],
    'br' => [],
    'sub' => [],
    'sup' => [],
    'mark' => [],
    'code' => ['class'],
  ];

  // Dangerous attribute patterns
  $dangerous_patterns = [
    '/^on/i',
    '/^javascript:/i',
    '/^vbscript:/i',
    '/^data:/i',
  ];

  $xpath = new \DOMXPath($dom);
  $elements = $xpath->query('//*');

  foreach ($elements as $element) {
    if (!$element instanceof \DOMElement) {
      continue;
    }

    $tagName = strtolower($element->tagName);

    if ($tagName === 'div' || $tagName === 'body' || $tagName === 'html') {
      continue;
    }

    $tagAllowed = $allowed_attributes[$tagName] ?? [];
    $attributesToRemove = [];

    foreach ($element->attributes as $attr) {
      $attrName = strtolower($attr->name);
      $attrValue = $attr->value;

      if (!in_array($attrName, $tagAllowed)) {
        $attributesToRemove[] = $attr->name;
        continue;
      }

      foreach ($dangerous_patterns as $pattern) {
        if (preg_match($pattern, $attrValue)) {
          $attributesToRemove[] = $attr->name;
          break;
        }
      }

      if ($attrName === 'href') {
        $parsed = parse_url($attrValue);
        $scheme = strtolower($parsed['scheme'] ?? '');
        if ($scheme && !in_array($scheme, ['http', 'https', 'mailto', 'tel'])) {
          $attributesToRemove[] = $attr->name;
        }
      }
    }

    foreach ($attributesToRemove as $attrName) {
      $element->removeAttribute($attrName);
    }

    if ($tagName === 'a' && $element->hasAttribute('href')) {
      $href = $element->getAttribute('href');
      if (strpos($href, 'http') === 0) {
        $element->setAttribute('rel', 'noopener noreferrer');
      }
    }
  }

  $result = '';
  $wrapper = $dom->getElementsByTagName('div')->item(0);
  if ($wrapper) {
    foreach ($wrapper->childNodes as $child) {
      $result .= $dom->saveHTML($child);
    }
  }

  return $result ?: $html;
}

/**
 * Remove empty <p> tags from content.
 *
 * @param string $content
 *   HTML content that may contain empty <p> tags.
 *
 * @return string
 *   Content with empty <p> tags removed.
 */
function pwc_visual_editor_remove_empty_paragraphs(string $content): string {
  // Remove <p> tags that are empty or only contain whitespace/br tags
  // Pattern matches <p ...></p> or <p ...><br></p> or <p ...>   </p>
  $content = preg_replace('/<p[^>]*>\s*(<br\s*\/?>)?\s*<\/p>/i', '', $content);

  return trim($content);
}

/**
 * Convert <br><br> patterns inside <p> tags to separate paragraphs.
 *
 * @param string $content
 *   HTML content that may contain <br><br> patterns.
 *
 * @return string
 *   Content with <br><br> converted to separate <p> tags.
 */
function pwc_visual_editor_convert_double_br_to_paragraphs(string $content): string {
  // Match <p> tags containing <br><br> (with optional whitespace)
  $pattern = '/<p([^>]*)>([\s\S]*?)<\/p>/i';

  return preg_replace_callback($pattern, function($matches) {
    $attrs = $matches[1];
    $innerContent = $matches[2];

    // Check if there are double <br> tags
    if (preg_match('/<br\s*\/?>\s*<br\s*\/?>/i', $innerContent)) {
      // Split by double <br> and create separate paragraphs
      $parts = preg_split('/<br\s*\/?>\s*<br\s*\/?>/i', $innerContent);
      $paragraphs = [];
      foreach ($parts as $part) {
        $part = trim($part);
        if ($part) {
          $paragraphs[] = "<p{$attrs}>{$part}</p>";
        }
      }
      return implode('', $paragraphs);
    }

    return $matches[0];
  }, $content);
}

/**
 * Sanitize paragraph HTML content, allowing <p>, <br>, and safe inline tags.
 *
 * @param string $content
 *   Raw content that may contain HTML.
 *
 * @return string
 *   Sanitized HTML with only allowed tags.
 */
function pwc_visual_editor_sanitize_paragraph_html(string $content): string {
  // List of allowed tags for paragraphs
  $allowed_tags = '<p><br><strong><em><b><i><a><span><sub><sup><mark><code>';

  // Strip all tags except allowed ones
  $content = strip_tags($content, $allowed_tags);

  // Sanitize attributes on allowed tags
  if (strpos($content, '<') !== FALSE) {
    $content = pwc_visual_editor_sanitize_paragraph_attributes($content);
  }

  return $content;
}

/**
 * Sanitize attributes on paragraph HTML tags.
 *
 * @param string $html
 *   HTML content with allowed tags.
 *
 * @return string
 *   HTML with sanitized attributes.
 */
function pwc_visual_editor_sanitize_paragraph_attributes(string $html): string {
  // Wrap in a root element to ensure valid parsing
  $wrapped = '<div>' . $html . '</div>';

  $dom = new \DOMDocument();
  @$dom->loadHTML('<?xml encoding="UTF-8">' . $wrapped, LIBXML_HTML_NOIMPLIED | LIBXML_HTML_NODEFDTD);

  // Allowed attributes per tag
  $allowed_attributes = [
    'p' => ['class'],
    'a' => ['href', 'title', 'target', 'rel'],
    'span' => ['class'],
    'strong' => [],
    'em' => [],
    'b' => [],
    'i' => [],
    'br' => [],
    'sub' => [],
    'sup' => [],
    'mark' => [],
    'code' => ['class'],
  ];

  // Dangerous attribute patterns
  $dangerous_patterns = [
    '/^on/i',
    '/^javascript:/i',
    '/^vbscript:/i',
    '/^data:/i',
  ];

  $xpath = new \DOMXPath($dom);
  $elements = $xpath->query('//*');

  foreach ($elements as $element) {
    if (!$element instanceof \DOMElement) {
      continue;
    }

    $tagName = strtolower($element->tagName);

    if ($tagName === 'div' || $tagName === 'body' || $tagName === 'html') {
      continue;
    }

    $tagAllowed = $allowed_attributes[$tagName] ?? [];
    $attributesToRemove = [];

    foreach ($element->attributes as $attr) {
      $attrName = strtolower($attr->name);
      $attrValue = $attr->value;

      if (!in_array($attrName, $tagAllowed)) {
        $attributesToRemove[] = $attr->name;
        continue;
      }

      foreach ($dangerous_patterns as $pattern) {
        if (preg_match($pattern, $attrValue)) {
          $attributesToRemove[] = $attr->name;
          break;
        }
      }

      if ($attrName === 'href') {
        $parsed = parse_url($attrValue);
        $scheme = strtolower($parsed['scheme'] ?? '');
        if ($scheme && !in_array($scheme, ['http', 'https', 'mailto', 'tel'])) {
          $attributesToRemove[] = $attr->name;
        }
      }
    }

    foreach ($attributesToRemove as $attrName) {
      $element->removeAttribute($attrName);
    }

    if ($tagName === 'a' && $element->hasAttribute('href')) {
      $href = $element->getAttribute('href');
      if (strpos($href, 'http') === 0) {
        $element->setAttribute('rel', 'noopener noreferrer');
      }
    }
  }

  $result = '';
  $wrapper = $dom->getElementsByTagName('div')->item(0);
  if ($wrapper) {
    foreach ($wrapper->childNodes as $child) {
      $result .= $dom->saveHTML($child);
    }
  }

  return $result ?: $html;
}

/**
 * Render a layout block with columns.
 *
 * @param array $attributes
 *   Block attributes.
 * @param array $innerBlocks
 *   Inner blocks (flat array with columnIndex attribute).
 *
 * @return string
 *   Rendered HTML.
 */
function pwc_visual_editor_render_layout(array $attributes, array $innerBlocks): string {
  // Skip rendering empty layout blocks in SSR
  if (empty($innerBlocks)) {
    return '';
  }

  $columns = (int) ($attributes['columns'] ?? 2);
  $gap = $attributes['gap'] ?? '4';
  $layout = $attributes['layout'] ?? 'equal';

  // Build layout classes
  $layoutClasses = ['pwc-layout-block', 'flex', 'flex-wrap'];
  $layoutClasses[] = 'gap-' . htmlspecialchars($gap);

  // Add margin if any
  if (!empty($attributes['margin'])) {
    $layoutClasses[] = htmlspecialchars($attributes['margin']);
  }

  // Add padding if any
  if (!empty($attributes['padding'])) {
    $layoutClasses[] = htmlspecialchars($attributes['padding']);
  }

  // Add background color if any
  if (!empty($attributes['backgroundColor'])) {
    $layoutClasses[] = htmlspecialchars($attributes['backgroundColor']);
  }

  // Add border width if any
  if (!empty($attributes['borderWidth'])) {
    $layoutClasses[] = htmlspecialchars($attributes['borderWidth']);
  }

  // Add border color if any
  if (!empty($attributes['borderColor'])) {
    $layoutClasses[] = htmlspecialchars($attributes['borderColor']);
  }

  // Add border radius if any
  if (!empty($attributes['borderRadius'])) {
    $layoutClasses[] = htmlspecialchars($attributes['borderRadius']);
  }

  // Add custom classes if any
  if (!empty($attributes['customClasses'])) {
    $layoutClasses[] = htmlspecialchars($attributes['customClasses']);
  }

  $layoutClassString = implode(' ', $layoutClasses);

  // Group inner blocks by columnIndex
  $blocksByColumn = [];
  for ($i = 0; $i < $columns; $i++) {
    $blocksByColumn[$i] = [];
  }

  foreach ($innerBlocks as $block) {
    $columnIndex = (int) ($block['attributes']['columnIndex'] ?? 0);
    // Ensure column index is within bounds
    if ($columnIndex >= $columns) {
      $columnIndex = 0;
    }
    $blocksByColumn[$columnIndex][] = $block;
  }

  $html = "<div class=\"{$layoutClassString}\">\n";

  // Render each column
  for ($columnIndex = 0; $columnIndex < $columns; $columnIndex++) {
    // Column width classes based on layout
    $widthClass = pwc_visual_editor_get_column_width_class($layout, $columnIndex, $columns);

    $columnClasses = ['pwc-layout-column', $widthClass];
    $columnClassString = implode(' ', array_filter($columnClasses));

    $html .= "  <div class=\"{$columnClassString}\">\n";
    $html .= "    <div class=\"pwc-layout-column__content\">\n";

    // Render blocks inside this column
    foreach ($blocksByColumn[$columnIndex] as $innerBlock) {
      $html .= '      ' . pwc_visual_editor_render_block($innerBlock);
    }

    $html .= "    </div>\n";
    $html .= "  </div>\n";
  }

  $html .= "</div>\n";

  return $html;
}

/**
 * Get Tailwind width class for a column based on layout.
 *
 * @param string $layout
 *   Layout type (equal, 1-2, 2-1, 1-2-1, etc.).
 * @param int $index
 *   Column index.
 * @param int $totalColumns
 *   Total number of columns.
 *
 * @return string
 *   Tailwind width class.
 */
function pwc_visual_editor_get_column_width_class(string $layout, int $index, int $totalColumns): string {
  // Layout patterns and their column width distributions
  $layouts = [
    'equal' => [], // Will calculate based on totalColumns
    '1-2' => ['w-1/3', 'w-2/3'],
    '2-1' => ['w-2/3', 'w-1/3'],
    '1-2-1' => ['w-1/4', 'w-1/2', 'w-1/4'],
    '1-3' => ['w-1/4', 'w-3/4'],
    '3-1' => ['w-3/4', 'w-1/4'],
  ];

  if ($layout === 'equal' || !isset($layouts[$layout])) {
    // Equal distribution
    switch ($totalColumns) {
      case 1:
        return 'w-full';
      case 2:
        return 'w-1/2';
      case 3:
        return 'w-1/3';
      case 4:
        return 'w-1/4';
      default:
        return 'w-full';
    }
  }

  return $layouts[$layout][$index] ?? 'w-full';
}

/**
 * Implements hook_menu_local_tasks_alter().
 *
 * Hide View/Edit/Delete/Revisions tabs on Visual Pages.
 */
function pwc_visual_editor_menu_local_tasks_alter(&$data, $route_name, \Drupal\Core\Cache\RefinableCacheableDependencyInterface &$cacheability) {
  // Only process on node routes
  $route_match = \Drupal::routeMatch();
  $node = $route_match->getParameter('node');

  if (!$node instanceof NodeInterface) {
    return;
  }

  // Only hide tabs for visual_page content type
  if ($node->bundle() !== 'visual_page') {
    return;
  }

  // Remove all local tasks (tabs) for Visual Pages
  $data['tabs'] = [];
}

/**
 * Implements hook_preprocess_page().
 *
 * Add class to body for Visual Pages to enable CSS hiding.
 */
function pwc_visual_editor_preprocess_page(&$variables) {
  $route_match = \Drupal::routeMatch();
  $node = $route_match->getParameter('node');

  if ($node instanceof NodeInterface && $node->bundle() === 'visual_page') {
    $variables['#attached']['library'][] = 'pwc_visual_editor/visual_page';
  }
}
